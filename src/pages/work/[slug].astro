---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { works, getWork } from '../../data/work';

export function getStaticPaths() {
  return works.map((w) => ({ params: { slug: w.slug } }));
}

const { slug } = Astro.params;
const work = getWork(slug!);
if (!work) return Astro.redirect('/404');

// TODO: replace placeholder content with the real case study.
const facts = [
  { label: 'Client', value: work.title },
  { label: 'Type', value: work.type },
  { label: 'Sector', value: work.tag },
  { label: 'Year', value: '2024' },
  { label: 'Timeline', value: 'Placeholder — 6 weeks' },
  { label: 'Role', value: 'Placeholder — Strategy, design & build' },
];

const sections = [
  {
    heading: 'The challenge',
    body: 'Placeholder copy. Describe the business problem the client came to us with, the constraints, and what was at stake if it went unsolved.',
  },
  {
    heading: 'The approach',
    body: 'Placeholder copy. Walk through the strategy we set, the decisions that shaped the work, and how we moved from problem to direction.',
  },
  {
    heading: 'The outcome',
    body: 'Placeholder copy. Show the results with concrete metrics — revenue, cost, time saved, conversion — and what changed for the client after launch.',
  },
];
---
<Layout>
  <Nav />

  <main class="px-6 md:px-12 pt-32 pb-28">
    <div class="max-w-4xl mx-auto">
      <a href="/#work" class="text-xs tracking-[0.3em] uppercase text-muted hover:text-crema transition-colors">
        ← Back to work
      </a>

      <header class="mt-8 mb-16">
        <p class="text-xs tracking-widest uppercase text-muted mb-4">{work.tag}</p>
        <h1 class="font-display font-extrabold text-[clamp(2.5rem,7vw,5rem)] leading-[1.05] text-crema">
          {work.title}
        </h1>
        <p class="mt-5 max-w-2xl text-lg text-muted-2 leading-relaxed">{work.outcome}</p>
      </header>

      <!-- Placeholder hero visual -->
      <div
        class="h-80 md:h-[28rem] rounded-2xl overflow-hidden relative flex items-center justify-center mb-20"
        style={`background: ${work.color};`}
      >
        <div
          class="absolute inset-0 opacity-25"
          style={`background: radial-gradient(circle at 30% 60%, ${work.accent}, transparent 70%);`}
        ></div>
        <span
          class="font-display font-extrabold text-[10rem] leading-none select-none opacity-10"
          style={`color: ${work.accent};`}
        >{work.title[0]}</span>
      </div>

      <!-- Fact sheet -->
      <dl class="grid grid-cols-2 md:grid-cols-3 gap-8 mb-20 border-t border-panel pt-10">
        {facts.map((f) => (
          <div>
            <dt class="text-xs tracking-widest uppercase text-muted mb-2">{f.label}</dt>
            <dd class="text-sm text-crema">{f.value}</dd>
          </div>
        ))}
      </dl>

      <!-- Narrative sections -->
      <div class="space-y-16">
        {sections.map((s) => (
          <section>
            <h2 class="font-display font-bold text-2xl md:text-3xl text-crema mb-4">{s.heading}</h2>
            <p class="text-muted-2 leading-relaxed max-w-2xl">{s.body}</p>
          </section>
        ))}
      </div>

      <!-- CTA -->
      <div class="mt-24 border-t border-panel pt-12">
        <p class="font-display font-bold text-2xl text-crema mb-4">Have a problem worth solving?</p>
        <a
          href="/#contact"
          class="inline-block px-5 py-2.5 bg-fractura text-antracita font-semibold text-sm rounded-full hover:bg-fractura-dark transition-colors"
        >Start a project</a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
