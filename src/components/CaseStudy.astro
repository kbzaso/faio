---
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import { resolveWork, type Work } from '../data/work';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n';

interface Props {
  work: Work;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const work = resolveWork(Astro.props.work, lang);

const backHref = `${localizePath('/', lang)}#work`;
const contactHref = `${localizePath('/', lang)}#contact`;

// TODO: replace placeholder content with the real case study.
const facts = [
  { label: t.caseStudy.facts.client, value: work.title },
  { label: t.caseStudy.facts.type, value: work.type },
  { label: t.caseStudy.facts.sector, value: work.tag },
  { label: t.caseStudy.facts.year, value: '2024' },
  { label: t.caseStudy.facts.timeline, value: t.caseStudy.factValues.timeline },
  { label: t.caseStudy.facts.role, value: t.caseStudy.factValues.role },
];
---
<Nav />

<main class="px-6 md:px-12 pt-32 pb-28">
  <div class="max-w-4xl mx-auto">
    <a href={backHref} class="text-xs tracking-[0.3em] uppercase text-ink-2 hover:text-ink transition-colors">
      {t.caseStudy.back}
    </a>

    <header class="mt-8 mb-16">
      <p class="text-xs tracking-widest uppercase text-ink-2 mb-4">{work.tag}</p>
      <h1 class="hand text-[clamp(2.25rem,8vw,5.5rem)] text-tierra-profunda">
        {work.title}
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-ink-2 leading-relaxed">{work.outcome}</p>
    </header>

    <!-- Cover: same image and transition name as the home card. -->
    <div class="h-80 md:h-[28rem] rounded-2xl overflow-hidden relative mb-20 bg-piedra" style={`view-transition-name: work-${work.slug}`}>
      <img
        src={work.image}
        alt={work.title}
        width="1600"
        height="900"
        decoding="async"
        class="absolute inset-0 w-full h-full object-cover"
      />
    </div>

    <!-- Fact sheet -->
    <dl class="grid grid-cols-2 md:grid-cols-3 gap-8 mb-20 border-t border-line pt-10">
      {facts.map((f) => (
        <div>
          <dt class="text-xs tracking-widest uppercase text-ink-2 mb-2">{f.label}</dt>
          <dd class="mark tabular text-lg text-ink">{f.value}</dd>
        </div>
      ))}
    </dl>

    <!-- Narrative sections -->
    <div class="space-y-16">
      {t.caseStudy.sections.map((s) => (
        <section>
          <h2 class="display text-2xl md:text-3xl text-ink mb-4">{s.heading}</h2>
          <p class="text-ink-2 leading-relaxed max-w-2xl">{s.body}</p>
        </section>
      ))}
    </div>

    <!-- CTA -->
    <div class="mt-24 border-t border-line pt-12">
      <p class="display text-2xl text-ink mb-4">{t.caseStudy.ctaTitle}</p>
      <a
        href={contactHref}
        class="btn btn-primary"
      >{t.caseStudy.ctaButton}</a>
    </div>
  </div>
</main>

<Footer />
