---
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import { resolveWork, type Work } from '../data/work';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n';

interface Props {
  work: Work;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const work = resolveWork(Astro.props.work, lang);

const backHref = `${localizePath('/', lang)}#work`;
const contactHref = `${localizePath('/', lang)}#contact`;

// TODO: replace placeholder content with the real case study.
const facts = [
  { label: t.caseStudy.facts.client, value: work.title },
  { label: t.caseStudy.facts.type, value: work.type },
  { label: t.caseStudy.facts.sector, value: work.tag },
  { label: t.caseStudy.facts.year, value: '2024' },
  { label: t.caseStudy.facts.timeline, value: t.caseStudy.factValues.timeline },
  { label: t.caseStudy.facts.role, value: t.caseStudy.factValues.role },
];
---
<Nav />

<main class="px-6 md:px-12 pt-32 pb-28">
  <div class="max-w-4xl mx-auto">
    <a href={backHref} class="text-xs tracking-[0.3em] uppercase text-muted hover:text-crema transition-colors">
      {t.caseStudy.back}
    </a>

    <header class="mt-8 mb-16">
      <p class="text-xs tracking-widest uppercase text-muted mb-4">{work.tag}</p>
      <h1 class="font-display font-bold text-[clamp(1.75rem,7vw,5rem)] leading-[1.05] text-crema">
        {work.title}
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-muted-2 leading-relaxed">{work.outcome}</p>
    </header>

    <!-- Placeholder hero visual -->
    <div
      class="h-80 md:h-[28rem] rounded-2xl overflow-hidden relative flex items-center justify-center mb-20"
      style={`background: ${work.color};`}
    >
      <div
        class="absolute inset-0 opacity-25"
        style={`background: radial-gradient(circle at 30% 60%, ${work.accent}, transparent 70%);`}
      ></div>
      <span
        class="font-display font-extrabold text-[10rem] leading-none select-none opacity-10"
        style={`color: ${work.accent};`}
      >{work.title[0]}</span>
    </div>

    <!-- Fact sheet -->
    <dl class="grid grid-cols-2 md:grid-cols-3 gap-8 mb-20 border-t border-panel pt-10">
      {facts.map((f) => (
        <div>
          <dt class="text-xs tracking-widest uppercase text-muted mb-2">{f.label}</dt>
          <dd class="text-sm text-crema">{f.value}</dd>
        </div>
      ))}
    </dl>

    <!-- Narrative sections -->
    <div class="space-y-16">
      {t.caseStudy.sections.map((s) => (
        <section>
          <h2 class="font-display font-bold text-2xl md:text-3xl text-crema mb-4">{s.heading}</h2>
          <p class="text-muted-2 leading-relaxed max-w-2xl">{s.body}</p>
        </section>
      ))}
    </div>

    <!-- CTA -->
    <div class="mt-24 border-t border-panel pt-12">
      <p class="font-display font-bold text-2xl text-crema mb-4">{t.caseStudy.ctaTitle}</p>
      <a
        href={contactHref}
        class="inline-block px-5 py-2.5 bg-fractura text-antracita font-semibold text-sm rounded-full hover:bg-fractura-dark transition-colors"
      >{t.caseStudy.ctaButton}</a>
    </div>
  </div>
</main>

<Footer />
