---
import { getLangFromUrl, useTranslations } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const f = t.contact.form;

/* The site builds to static files, so there is no server of ours to post to.
   Web3Forms takes the submission and forwards it to the inbox its key is tied
   to. The key is public by design — it only ever grants *sending* to that one
   inbox, which is why it is a `PUBLIC_` env var and safe to ship in the HTML. */
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';

if (!accessKey) {
  console.warn(
    '[contact] PUBLIC_WEB3FORMS_KEY is not set — the form will render but not send. ' +
    'Grab a free key at https://web3forms.com and add it to .env (see .env.example).'
  );
}

const subject = lang === 'es'
  ? 'Nueva consulta desde faio.cl'
  : 'New inquiry from faio.cl';

const inputClass =
  'bg-antracita border border-panel-2 rounded-lg px-4 py-3 text-crema text-sm ' +
  'placeholder:text-muted focus:outline-none focus:border-tierra transition-colors ' +
  'aria-[invalid=true]:border-tierra';
---
<section id="contact" class="px-6 md:px-12 py-28 bg-panel/30">
  <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-16 items-start">
    <!-- Left -->
    <div>
      <p class="text-xs tracking-[0.3em] uppercase text-muted mb-5">{t.contact.eyebrow}</p>
      <h2 class="font-display font-bold text-[clamp(1.5rem,3.1vw,2.75rem)] text-crema leading-tight mb-6">
        {t.contact.titleLine1}<br />
        <span class="text-tierra">{t.contact.titleHighlight}</span>
      </h2>
      <p class="text-muted-2 leading-relaxed max-w-md mb-10">
        {t.contact.body}
      </p>

      <div class="space-y-4 text-sm">
        {t.contact.bullets.map((b) => (
          <div class="flex items-center gap-3 text-muted">
            <div class="w-1.5 h-1.5 rounded-full bg-tierra"></div>
            <span>{b.pre}{b.strong && <span class="text-crema">{b.strong}</span>}{b.post}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Right: Form -->
    <form
      id="contact-form"
      class="bg-panel rounded-2xl p-8 border border-panel-2"
      novalidate
    >
      <!-- Web3Forms metadata. Never shown, never edited by the visitor. -->
      <input type="hidden" name="access_key" value={accessKey} />
      <input type="hidden" name="subject" value={subject} />
      <input type="hidden" name="from_name" value="FAIO — Website" />
      <input type="hidden" name="locale" value={lang} />

      <!-- Honeypot. Bots fill every field they find; humans never see this one,
           so anything that arrives with it set is dropped without sending. -->
      <label class="sr-only" aria-hidden="true">
        <span>Leave this field empty</span>
        <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />
      </label>

      <div class="space-y-5" data-body>
        <div class="grid grid-cols-2 gap-4">
          <div class="flex flex-col gap-2">
            <label class="text-xs text-muted tracking-wide uppercase" for="name">{f.name}</label>
            <input
              id="name"
              name="name"
              type="text"
              required
              autocomplete="name"
              placeholder={f.namePlaceholder}
              aria-describedby="name-error"
              class={inputClass}
            />
            <p id="name-error" class="text-xs text-tierra" data-error-for="name" hidden></p>
          </div>
          <div class="flex flex-col gap-2">
            <label class="text-xs text-muted tracking-wide uppercase" for="company">
              {f.company} <span class="normal-case tracking-normal text-muted/70">({f.optional})</span>
            </label>
            <input
              id="company"
              name="company"
              type="text"
              autocomplete="organization"
              placeholder={f.companyPlaceholder}
              class={inputClass}
            />
          </div>
        </div>

        <div class="flex flex-col gap-2">
          <label class="text-xs text-muted tracking-wide uppercase" for="email">{f.email}</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder={f.emailPlaceholder}
            aria-describedby="email-error"
            class={inputClass}
          />
          <p id="email-error" class="text-xs text-tierra" data-error-for="email" hidden></p>
        </div>

        <div class="flex flex-col gap-2">
          <label class="text-xs text-muted tracking-wide uppercase" for="service">{f.service}</label>
          <select
            id="service"
            name="service"
            required
            aria-describedby="service-error"
            class:list={['select-arrow appearance-none', inputClass]}
          >
            <option value="" disabled selected>{f.servicePlaceholder}</option>
            <option value={f.serviceOptions.identity}>{f.serviceOptions.identity}</option>
            <option value={f.serviceOptions.strategy}>{f.serviceOptions.strategy}</option>
            <option value={f.serviceOptions.digital}>{f.serviceOptions.digital}</option>
            {/* hidden-sprint: restore with the Brand Sprint service card */}
            <option value={f.serviceOptions.unsure}>{f.serviceOptions.unsure}</option>
          </select>
          <p id="service-error" class="text-xs text-tierra" data-error-for="service" hidden></p>
        </div>

        <div class="flex flex-col gap-2">
          <label class="text-xs text-muted tracking-wide uppercase" for="message">{f.message}</label>
          <textarea
            id="message"
            name="message"
            rows="4"
            required
            placeholder={f.messagePlaceholder}
            aria-describedby="message-error"
            class:list={['resize-none', inputClass]}
          ></textarea>
          <p id="message-error" class="text-xs text-tierra" data-error-for="message" hidden></p>
        </div>

        <p
          class="text-sm text-tierra text-center"
          data-status
          role="alert"
          hidden
        ></p>

        <button
          type="submit"
          data-submit
          class="w-full py-4 bg-fractura text-antracita font-semibold rounded-full hover:bg-fractura-dark transition-colors disabled:opacity-60 disabled:cursor-not-allowed"
        >{f.submit}</button>
      </div>

      <!-- Swapped in for the fields once the submission lands. -->
      <div class="text-center py-6" data-success tabindex="-1" hidden>
        <div class="w-12 h-12 rounded-full bg-tierra/15 text-tierra mx-auto mb-5 grid place-items-center text-xl">✓</div>
        <p class="font-display font-bold text-xl text-crema mb-2">{f.success.title}</p>
        <p class="text-sm text-muted-2 leading-relaxed max-w-xs mx-auto mb-6">{f.success.body}</p>
        <button
          type="button"
          data-reset
          class="text-sm text-muted hover:text-crema underline underline-offset-4 transition-colors"
        >{f.success.again}</button>
      </div>
    </form>
  </div>
</section>

<script define:vars={{ strings: { errors: f.errors, submit: f.submit, submitting: f.submitting } }}>
  const form = document.getElementById('contact-form');
  if (form) {
    const body = form.querySelector('[data-body]');
    const success = form.querySelector('[data-success]');
    const status = form.querySelector('[data-status]');
    const button = form.querySelector('[data-submit]');
    const honeypot = form.elements.botcheck;

    const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    /** Returns the error message for a field, or '' when it passes. */
    const check = (field) => {
      const value = form.elements[field].value.trim();
      if (!value) return strings.errors[field];
      if (field === 'email' && !EMAIL.test(value)) return strings.errors.email;
      return '';
    };

    const paint = (field, message) => {
      const input = form.elements[field];
      const slot = form.querySelector(`[data-error-for="${field}"]`);
      slot.textContent = message;
      slot.hidden = !message;
      input.setAttribute('aria-invalid', message ? 'true' : 'false');
      return !message;
    };

    const FIELDS = ['name', 'email', 'service', 'message'];
    let validateAsYouType = false;

    // Only start correcting people once they have tried to send — flagging an
    // empty field the moment it is tabbed past is what makes forms feel hostile.
    FIELDS.forEach((field) => {
      const input = form.elements[field];
      const revalidate = () => validateAsYouType && paint(field, check(field));
      input.addEventListener('input', revalidate);
      input.addEventListener('change', revalidate);
      input.addEventListener('blur', revalidate);
    });

    const setStatus = (message) => {
      status.textContent = message;
      status.hidden = !message;
    };

    const setLoading = (loading) => {
      button.disabled = loading;
      button.textContent = loading ? strings.submitting : strings.submit;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      setStatus('');

      // A bot tripped the honeypot: act as though it worked and send nothing.
      if (honeypot && honeypot.checked) {
        body.hidden = true;
        success.hidden = false;
        return;
      }

      validateAsYouType = true;
      const failed = FIELDS.filter((field) => !paint(field, check(field)));
      if (failed.length) {
        form.elements[failed[0]].focus();
        return;
      }

      setLoading(true);
      try {
        const payload = Object.fromEntries(new FormData(form));
        delete payload.botcheck;

        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = await response.json().catch(() => ({}));

        if (!response.ok || !result.success) throw new Error(result.message || 'Submission failed');

        form.reset();
        validateAsYouType = false;
        FIELDS.forEach((field) => paint(field, ''));
        body.hidden = true;
        success.hidden = false;
        success.focus();
      } catch (error) {
        console.error('[contact]', error);
        setStatus(strings.errors.network);
      } finally {
        setLoading(false);
      }
    });

    form.querySelector('[data-reset]').addEventListener('click', () => {
      success.hidden = true;
      body.hidden = false;
      form.elements.name.focus();
    });
  }
</script>
