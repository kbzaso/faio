---
import { getLangFromUrl, useTranslations } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<section id="process" class="px-6 md:px-12 py-28 bg-panel/30">
  <div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="mb-16">
      <p class="text-xs tracking-[0.3em] uppercase text-muted mb-3">{t.process.eyebrow}</p>
      <h2 class="font-display font-bold text-[clamp(1.5rem,5vw,3.5rem)] text-crema leading-tight">
        {t.process.titleLine1}<br />{t.process.titleLine2}
      </h2>
    </div>

    <!-- Steps -->
    <div class="grid md:grid-cols-4 gap-px bg-panel">
      {t.process.steps.map((s) => (
        <div class="bg-antracita p-8 group hover:bg-panel transition-colors duration-300">
          <div class="text-tierra font-display font-bold text-5xl mb-8 leading-none">{s.num}</div>
          <h3 class="font-display font-bold text-xl text-crema mb-4">{s.title}</h3>
          <p class="text-sm text-muted-2 leading-relaxed mb-8">{s.desc}</p>
          <div class="flex items-center gap-2">
            <div class="w-1.5 h-1.5 rounded-full bg-tierra animate-pulse-dot"></div>
            <span class="text-xs text-muted tracking-wide">{s.duration}</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom note -->
    <p class="mt-8 text-sm text-muted text-center">
      {t.process.footnote.pre}<span class="text-crema">{t.process.footnote.strong}</span>{t.process.footnote.post}
    </p>
  </div>
</section>
