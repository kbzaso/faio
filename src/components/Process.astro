---
import { getLangFromUrl, useTranslations } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<section id="process" class="on-dark px-6 md:px-12 pt-36 md:pt-44 pb-24 md:pb-32 min-h-[80svh]">
  <div class="max-w-6xl mx-auto">
    <h2 data-reveal class="display text-[clamp(2rem,5.5vw,4.25rem)] max-w-3xl mb-16 md:mb-24">
      {t.process.titleLine1}<br />{t.process.titleLine2}
    </h2>

    <!-- La secuencia sí informa: cada etapa depende de la anterior. -->
    <ol class="grid md:grid-cols-4 gap-x-8 gap-y-14">
      {t.process.steps.map((s) => (
        <li data-reveal class="border-t border-line pt-6">
          <p class="mark tabular text-tierra text-6xl mb-8">{s.num}</p>
          <h3 class="display text-2xl mb-4 !leading-tight">{s.title}</h3>
          <p class="text-[0.95rem] text-ink-2 leading-relaxed mb-6">{s.desc}</p>
          <p class="text-xs font-medium tracking-wide text-ink-2 tabular">{s.duration}</p>
        </li>
      ))}
    </ol>

    <p data-reveal class="mt-20 text-ink-2 max-w-xl">
      {t.process.footnote.pre}<span class="text-link font-semibold">{t.process.footnote.strong}</span>{t.process.footnote.post}
    </p>
  </div>
</section>
