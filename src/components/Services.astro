---
import { getLangFromUrl, useTranslations } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// hidden-sprint: three services while Brand Sprint is parked.
// hidden-prices: prices are off the site for now. Restore the amounts together
// with `pricePrefix`/`priceAmount` in the i18n dictionaries; they belong in the
// right-hand column under each title, in `tabular` numerals.
---
<section id="services" class="px-6 md:px-12 py-24 md:py-32 bg-piedra/40">
  <div class="max-w-6xl mx-auto">
    <h2 data-reveal class="display text-[clamp(2rem,5.5vw,4.25rem)] text-antracita max-w-3xl mb-16 md:mb-20">
      {t.services.titleLine1}<br />{t.services.titleLine2}
    </h2>

    <ul class="border-t border-antracita">
      {t.services.items.map((s) => (
        <li data-reveal class="grid md:grid-cols-[5fr_4fr_auto] gap-6 md:gap-12 py-10 border-b border-piedra items-start">
          <div>
            <h3 class="display text-3xl md:text-4xl text-antracita !leading-tight mb-4">{s.title}</h3>
            <p class="text-ceniza leading-relaxed max-w-md">{s.desc}</p>
          </div>
          <ul class="space-y-2 text-sm text-antracita md:pt-2">
            {s.features.map((f) => (
              <li class="flex gap-3"><span class="mt-[0.55em] w-3 h-px bg-tierra shrink-0"></span>{f}</li>
            ))}
          </ul>
          <a href="#contact" class="btn btn-ghost md:self-end">{t.services.quote}</a>
        </li>
      ))}
    </ul>

    <p data-reveal class="mt-10 text-ceniza">
      {t.services.footnote.pre}<a href="#contact" class="text-link underline underline-offset-4 font-medium">{t.services.footnote.link}</a>{t.services.footnote.post}
    </p>
  </div>
</section>
