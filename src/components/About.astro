---
import { getLangFromUrl, useTranslations } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<section id="about" class="px-6 md:px-12 py-28">
  <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-16 items-center">
    <!-- Left: visual -->
    <div class="relative">
      <div class="rounded-2xl overflow-hidden bg-panel aspect-[4/5] flex items-end p-8">
        <!-- Abstract brand mark -->
        <div class="absolute inset-0 flex items-center justify-center">
          <span
            class="font-display font-extrabold select-none leading-none text-[16rem] opacity-5 text-crema"
          >F</span>
        </div>
        <!-- Tierra block accent -->
        <div class="absolute top-8 left-8 w-12 h-1.5 bg-tierra rounded-full"></div>

        <div class="relative">
          <p class="text-xs tracking-widest uppercase text-muted mb-2">{t.about.since}</p>
          <p class="font-display font-bold text-3xl text-crema">{t.about.studio}</p>
        </div>
      </div>
      <!-- Floating stat card -->
      <div class="absolute -bottom-3 -right-3 sm:-bottom-6 sm:-right-6 bg-fractura text-antracita rounded-2xl p-5 shadow-2xl">
        <p class="font-display font-extrabold text-4xl leading-none">{t.about.badgeStat}</p>
        <p class="text-sm font-medium mt-1">{t.about.badgeLabel}</p>
      </div>
    </div>

    <!-- Right: text -->
    <div>
      <p class="text-xs tracking-[0.3em] uppercase text-muted mb-5">{t.about.eyebrow}</p>
      <h2 class="font-display font-bold text-[clamp(1.5rem,4vw,3rem)] text-crema leading-tight mb-8">
        {t.about.titleLine1}<br />{t.about.titleLine2}
      </h2>

      <div class="space-y-5 text-muted-2 leading-relaxed">
        {t.about.paragraphs.map((p) => <p>{p}</p>)}
      </div>

      <div class="mt-10 grid grid-cols-3 gap-6 border-t border-panel pt-8">
        {t.about.stats.map(({ stat, label }) => (
          <div>
            <p class="font-display font-bold text-2xl text-tierra">{stat}</p>
            <p class="text-xs text-muted mt-1">{label}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
