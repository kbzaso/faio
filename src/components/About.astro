---
import { getLangFromUrl, useTranslations } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<section id="about" class="px-6 md:px-12 pt-36 md:pt-44 pb-24 md:pb-32">
  <div class="max-w-6xl mx-auto grid md:grid-cols-[5fr_6fr] gap-14 md:gap-24">
    <div data-reveal>
      <h2 class="display text-[clamp(2.25rem,5.5vw,4.5rem)] text-antracita">
        {t.about.titleLine1}<br />{t.about.titleLine2}
      </h2>
      <p class="mt-8 text-sm font-medium text-ceniza tabular">{t.about.since} · {t.about.studio}</p>
    </div>

    <div data-reveal style="--reveal-delay:120ms">
      <div class="space-y-6 text-lg leading-relaxed text-antracita">
        {t.about.paragraphs.map((p, i) => <p class:list={[i > 0 && 'text-ceniza']}>{p}</p>)}
      </div>

      <dl class="mt-14 grid grid-cols-3 gap-6 border-t border-piedra pt-8">
        {t.about.stats.map(({ stat, label }) => (
          <div>
            <dd class="mark tabular text-5xl text-tierra order-first">{stat}</dd>
            <dt class="text-sm text-ceniza mt-2">{label}</dt>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
