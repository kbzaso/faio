---
import LanguageSwitcher from './LanguageSwitcher.astro';
import Logo from './Logo.astro';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const home = localizePath('/', lang);
const link = (hash: string) => `${home}${hash}`;

const items = [
  { href: home, label: t.nav.work },
  { href: localizePath('/process', lang), label: t.nav.process },
  { href: localizePath('/services', lang), label: t.nav.services },
  { href: localizePath('/about', lang), label: t.nav.about },
  { href: link('#contact'), label: t.nav.contact },
];
---
<footer class="on-dark px-6 md:px-12 py-14 border-t border-line">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-start md:items-end justify-between gap-10">
    <div>
      <Logo class="h-7 mb-4" />
      <p class="text-sm text-ink-2 max-w-xs">{t.footer.tagline}</p>
    </div>

    <nav class="flex flex-wrap gap-x-8 gap-y-3 text-sm text-ink-2">
      {items.map((item) => (
        <a href={item.href} class="hover:text-ink transition-colors">{item.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-6">
      <LanguageSwitcher />
      <p class="text-xs text-ink-2">© {new Date().getFullYear()} FAIO Studio. {t.footer.rights}</p>
    </div>
  </div>
</footer>
