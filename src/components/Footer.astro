---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const home = localizePath('/', lang);
const link = (hash: string) => `${home}${hash}`;

const items = [
  // hidden-sections: restore with the Work section in Home.astro
  // { href: link('#work'), label: t.nav.work },
  { href: link('#process'), label: t.nav.process },
  { href: link('#services'), label: t.nav.services },
  { href: link('#about'), label: t.nav.about },
  { href: link('#contact'), label: t.nav.contact },
];
---
<footer class="px-6 md:px-12 py-12 border-t border-panel">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
    <div>
      <p class="font-display font-extrabold text-xl text-crema mb-1">FAIO</p>
      <p class="text-xs text-muted">{t.footer.tagline}</p>
    </div>

    <nav class="flex flex-wrap gap-6 text-sm text-muted">
      {items.map((item) => (
        <a href={item.href} class="hover:text-crema transition-colors">{item.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-6">
      <LanguageSwitcher />
      <p class="text-xs text-muted">© {new Date().getFullYear()} FAIO Studio. {t.footer.rights}</p>
    </div>
  </div>
</footer>
