---
import { getLangFromUrl, useTranslations } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<section class="relative min-h-[100svh] flex flex-col justify-end px-6 md:px-12 pb-16 md:pb-20 pt-36 overflow-hidden">
  <div class="max-w-6xl w-full mx-auto">
    <h1 class="display text-[clamp(2.5rem,8vw,7rem)] text-antracita rise">
      {t.hero.titleLine1}<br />
      <!-- La única línea dorada de la pieza: el porqué. -->
      <span class="hand relative inline-block text-tierra-profunda">
        {t.hero.titleHighlight}
        <svg class="absolute left-0 -bottom-[0.06em] w-full h-[0.16em] overflow-visible" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true">
          <path class="crack" pathLength="1" d="M0 6 L14 3 L22 7 L41 2.5 L53 6.5 L72 3 L84 6 L100 4"
                fill="none" stroke="#EF9F27" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round" />
        </svg>
      </span>
      {t.hero.titleLine2 && <><br />{t.hero.titleLine2}</>}
    </h1>

    <div class="mt-14 md:mt-20 pt-8 border-t border-piedra grid md:grid-cols-[1fr_auto] gap-8 md:gap-16 items-end rise rise-2">
      <p class="max-w-xl text-lg md:text-xl text-ceniza leading-relaxed">{t.hero.body}</p>
      <div class="flex flex-wrap items-center gap-4">
        <a href="#contact" class="btn btn-primary">{t.hero.ctaPrimary}</a>
        <a href="#work" class="btn btn-ghost">{t.hero.ctaSecondary}</a>
      </div>
    </div>
  </div>
</section>
