---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Anchors are prefixed with the localized home path so the nav also works
// from the case-study pages, not just the one-pager.
const home = localizePath('/', lang);
const link = (hash: string) => `${home}${hash}`;

const items = [
  // hidden-sections: restore with the Work section in Home.astro
  // { href: link('#work'), label: t.nav.work },
  { href: link('#process'), label: t.nav.process },
  { href: link('#services'), label: t.nav.services },
  { href: link('#about'), label: t.nav.about },
];
---
<header class="fixed top-0 left-0 right-0 z-50 px-6 md:px-12 py-5 flex items-center justify-between backdrop-blur-md">
  <a href={home} class="font-display font-extrabold text-xl tracking-tight text-crema">FAIO</a>
  <nav class="hidden lg:flex items-center gap-8 text-sm text-muted">
    {items.map((item) => (
      <a href={item.href} class="hover:text-crema transition-colors">{item.label}</a>
    ))}
    <LanguageSwitcher />
    <a
      href={link('#contact')}
      class="px-4 py-2 bg-fractura text-antracita font-semibold text-sm rounded-full hover:bg-fractura-dark transition-colors"
    >{t.nav.cta}</a>
  </nav>
  <!-- Compact header: language + CTA. The CTA drops to a short label on the
       narrowest screens so it never crowds the switcher. -->
  <div class="flex lg:hidden items-center gap-3">
    <LanguageSwitcher />
    <a
      href={link('#contact')}
      class="px-4 py-2 bg-fractura text-antracita font-semibold text-sm rounded-full whitespace-nowrap"
    >
      <span class="sm:hidden">{t.nav.ctaShort}</span>
      <span class="hidden sm:inline">{t.nav.cta}</span>
    </a>
  </div>
</header>
