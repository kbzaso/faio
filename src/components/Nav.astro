---
import LanguageSwitcher from './LanguageSwitcher.astro';
import Logo from './Logo.astro';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Anchors are prefixed with the localized home path so the nav also works
// from the case-study pages, not just the one-pager.
const home = localizePath('/', lang);
const link = (hash: string) => `${home}${hash}`;

const items = [
  { href: home, label: t.nav.work, match: home },
  { href: localizePath('/process', lang), label: t.nav.process, match: localizePath('/process', lang) },
  { href: localizePath('/services', lang), label: t.nav.services, match: localizePath('/services', lang) },
  { href: localizePath('/about', lang), label: t.nav.about, match: localizePath('/about', lang) },
];
---
<header data-nav class="site-nav on-dark fixed top-0 left-0 right-0 z-50 px-6 md:px-12 py-4 flex items-center justify-between backdrop-blur-md border-b border-line text-ink">
  <a href={home} aria-label="FAIO"><Logo class="h-[1.05rem]" /></a>
  <nav class="hidden lg:flex items-center gap-9 text-sm font-medium text-ink-2">
    {items.map((item) => (
      <a
        href={item.href}
        aria-current={Astro.url.pathname === item.match || Astro.url.pathname === item.match + '/' ? 'page' : undefined}
        class="hover:text-ink transition-colors aria-[current=page]:text-ink aria-[current=page]:underline aria-[current=page]:underline-offset-8 aria-[current=page]:decoration-1"
      >{item.label}</a>
    ))}
    <LanguageSwitcher />
    <a href={link('#contact')} class="btn btn-primary !py-3 !px-5 !text-sm">{t.nav.cta}</a>
  </nav>
  <!-- Mobile: language switcher and a menu button. The links and the CTA live
       in the panel below, so the bar never crowds on narrow screens. -->
  <div class="flex lg:hidden items-center gap-3">
    <LanguageSwitcher />
    <button
      type="button"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label={t.nav.menu}
      data-label-open={t.nav.menu}
      data-label-close={t.nav.closeMenu}
      class="relative grid place-items-center w-11 h-11 -mr-2 border border-line text-ink"
    >
      <span class="sr-only" data-menu-label>{t.nav.menu}</span>
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path data-bar-top d="M3 6h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" class="origin-center transition-transform duration-300 ease-out" />
        <path data-bar-mid d="M3 10h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" class="transition-opacity duration-200" />
        <path data-bar-bot d="M3 14h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" class="origin-center transition-transform duration-300 ease-out" />
      </svg>
    </button>
  </div>

  <div
    id="mobile-menu"
    data-menu
    hidden
    class="lg:hidden absolute top-full left-0 right-0 bg-surface text-ink border-b border-line px-6 pt-6 pb-8 flex flex-col gap-8 max-h-[calc(100svh-4.5rem)] overflow-y-auto"
  >
    <nav class="flex flex-col" aria-label={t.nav.menu}>
      {items.map((item) => (
        <a
          href={item.href}
          aria-current={Astro.url.pathname === item.match || Astro.url.pathname === item.match + '/' ? 'page' : undefined}
          class="display text-4xl py-4 border-b border-line text-ink-2 aria-[current=page]:text-ink"
        >{item.label}</a>
      ))}
    </nav>
    <a href={link('#contact')} class="btn btn-primary w-full">{t.nav.cta}</a>
  </div>

  <script is:inline>
    (function () {
      var nav = document.querySelector('[data-nav]');
      if (!nav) return;
      var btn = nav.querySelector('[data-menu-toggle]');
      var panel = nav.querySelector('[data-menu]');
      if (!btn || !panel) return;
      var top = btn.querySelector('[data-bar-top]');
      var mid = btn.querySelector('[data-bar-mid]');
      var bot = btn.querySelector('[data-bar-bot]');
      var label = btn.querySelector('[data-menu-label]');

      function setOpen(open) {
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        var text = btn.getAttribute(open ? 'data-label-close' : 'data-label-open');
        btn.setAttribute('aria-label', text);
        if (label) label.textContent = text;
        panel.hidden = !open;
        document.documentElement.style.overflow = open ? 'hidden' : '';
        top.style.transform = open ? 'translateY(4px) rotate(45deg)' : '';
        bot.style.transform = open ? 'translateY(-4px) rotate(-45deg)' : '';
        mid.style.opacity = open ? '0' : '';
      }

      btn.addEventListener('click', function () {
        setOpen(btn.getAttribute('aria-expanded') !== 'true');
      });
      panel.addEventListener('click', function (e) {
        if (e.target.closest('a')) setOpen(false);
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
          setOpen(false);
          btn.focus();
        }
      });
      // Back to desktop width with the menu open: close it and release the scroll lock.
      window.matchMedia('(min-width: 1024px)').addEventListener('change', function (e) {
        if (e.matches) setOpen(false);
      });
      window.addEventListener('pagehide', function () { setOpen(false); });
    })();
  </script>
</header>
