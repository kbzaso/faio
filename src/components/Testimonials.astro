---
import { getLangFromUrl, useTranslations } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<section class="px-6 md:px-12 py-28">
  <div class="max-w-6xl mx-auto">
    <div class="mb-16">
      <p class="text-xs tracking-[0.3em] uppercase text-muted mb-3">{t.testimonials.eyebrow}</p>
      <h2 class="font-display font-bold text-[clamp(1.5rem,5vw,3.5rem)] text-crema leading-tight">
        {t.testimonials.titleLine1}<br />{t.testimonials.titleLine2}
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {t.testimonials.items.map((item) => (
        <blockquote class="bg-panel rounded-2xl p-8 flex flex-col justify-between border border-panel-2 hover:border-tierra/40 transition-colors duration-300">
          <!-- Quote mark -->
          <div>
            <span class="text-tierra font-display font-bold text-5xl leading-none select-none">"</span>
            <p class="text-crema leading-relaxed mt-2">{item.quote}</p>
          </div>

          <footer class="mt-8 flex items-center gap-3">
            <div class="w-9 h-9 rounded-full bg-tierra/20 flex items-center justify-center text-tierra font-bold text-sm flex-shrink-0">
              {item.initial}
            </div>
            <div>
              <p class="text-sm font-semibold text-crema">{item.author}</p>
              <p class="text-xs text-muted">{item.role}</p>
            </div>
          </footer>
        </blockquote>
      ))}
    </div>
  </div>
</section>
