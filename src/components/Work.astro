---
import { resolveWorks } from '../data/work';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const works = resolveWorks(lang);
---
<section id="work" class="px-6 md:px-12 pt-36 md:pt-44 pb-24 md:pb-32">
  <div class="max-w-6xl mx-auto">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-14 md:mb-20">
      <h2 data-reveal class="display text-[clamp(2rem,5.5vw,4.25rem)] text-ink max-w-2xl">
        {t.work.titleLine1}<br />{t.work.titleLine2}
      </h2>
      <p data-reveal class="max-w-xs text-ink-2 leading-relaxed">{t.work.note}</p>
    </div>

    <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {works.map((w, i) => (
        <li data-reveal class:list={[i === 0 && 'lg:col-span-2']}>
          <a
            href={localizePath(`/work/${w.slug}`, lang)}
            class="group flex flex-col h-full border border-line bg-surface overflow-hidden transition-[transform,border-color] duration-300 ease-out hover:-translate-y-1 hover:border-ink focus-visible:-translate-y-1"
          >
            <!-- Cover: the same image (and transition name) as the case-study hero,
                 so the browser morphs it from card to page. -->
            <div class:list={['relative overflow-hidden bg-piedra', i === 0 ? 'aspect-[4/3] lg:aspect-[16/7]' : 'aspect-[4/3]']} style={`view-transition-name: work-${w.slug}`}>
              <img
                src={w.image}
                alt=""
                width="1600"
                height="900"
                loading={i < 3 ? 'eager' : 'lazy'}
                decoding="async"
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
              />
              <span class="mark tabular absolute top-4 right-5 text-lg text-crema drop-shadow-[0_1px_6px_rgba(0,0,0,0.6)]">{String(i + 1).padStart(2, '0')}</span>
            </div>

            <div class="flex flex-col flex-1 p-6">
              <p class="text-sm font-medium text-ink-2 mb-3">{w.tag}</p>
              <h3 class="display text-3xl text-ink mb-2 !leading-tight">{w.title}</h3>
              <p class="text-ink-2 leading-relaxed mb-6 line-clamp-3">{w.type}</p>
              <span class="mt-auto inline-flex items-center gap-2 text-sm font-semibold text-link">
                {t.work.viewCase.replace(/\s*→\s*$/, '')}
                <svg class="transition-transform duration-300 group-hover:translate-x-1" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
