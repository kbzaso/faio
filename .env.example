# Web3Forms access key — the contact form posts here and Web3Forms forwards the
# submission to the inbox this key is registered to.
#
# Get one free (no account needed) at https://web3forms.com — you enter the
# destination email address and the key is mailed to you.
#
# `PUBLIC_` is intentional: the key ships in the built HTML and only ever allows
# sending to that one inbox, so it is not a secret. Without it the form renders
# and validates but every submission fails.
PUBLIC_WEB3FORMS_KEY=
